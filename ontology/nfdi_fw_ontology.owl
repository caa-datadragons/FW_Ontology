@prefix : <http://w3id.org/fw_ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix fw: <http://w3id.org/fw_ontology/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix amt: <http://academic-meta-tool.xyz/vocab#> .
@base <http://w3id.org/fw_ontology/> .

<http://w3id.org/fw_ontology/> rdf:type owl:Ontology ;
    dcterms:title "FW Ontology: classes and properties for fuzzy and wobbly data"@en ;
    dcterms:description "Classes and properties for modelling uncertain, vague and fuzzy/wobbly data in RDF, by the NFDI4Objects TWG FuzzyWobblySW (Community-Standards for modelling fuzziness and wobbliness in research data using Semantic Web technologies and formalisms)."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    rdfs:seeAlso <https://zenodo.org/records/14893827> ,
                 <https://zenodo.org/records/19877825> .

#################################################################
#    Object Properties
#################################################################

###  http://w3id.org/fw_ontology/hasCertainty
fw:hasCertainty rdf:type owl:ObjectProperty ;
                     rdfs:comment """To indicate a quantitative statement about the certainty of a given statement. 
Could for example be used with: https://fuzzy-sl.wikibase.cloud/wiki/Main_Page - Prefix: fuzzy-sl - URL: https://fuzzy-sl.wikibase.cloud/entity/"""@en .


#################################################################
#    Data properties
#################################################################

###  http://w3id.org/fw_ontology/hasConfidence
fw:hasConfidence rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf owl:topDataProperty ;
                      rdfs:comment "Indicates the confidence level [0–1] assigned by the contributor or the system. The closer the value is to 1, the higher the confidence. A value of 1.0 would correspond to a certain statement."@en .


###  http://w3id.org/fw_ontology/hasValue
fw:hasValue rdf:type owl:DatatypeProperty ;
                 rdfs:comment "For non resource values: numerical, years, ..."@en .


#################################################################
#    Classes
#################################################################

###  http://w3id.org/fw_ontology/FuzzinessWobblinessResourceValue
fw:FuzzinessWobblinessResourceValue rdf:type owl:Class ;
                                         rdfs:subClassOf fw:FuzzinessWobblinessValue .


###  http://w3id.org/fw_ontology/FuzzinessWobblinessValue
fw:FuzzinessWobblinessValue rdf:type owl:Class ;
                                 rdfs:comment "An object representing a set of vague and uncertain values or ranges. The provided values or ranges represent the current best values. It might be further qualified by the hasConfidence property."@en .


###  http://w3id.org/fw_ontology/UncertainValue
fw:UncertainValue rdf:type owl:Class ;
                       rdfs:comment "Represents the most likely value, although it may also be a different value."@en .
					   
###  http://w3id.org/fw_ontology/UncertainResourceValue
fw:UncertainResourceValue rdf:type owl:Class ;
                       rdfs:subClassOf fw:UncertainValue .


###  http://w3id.org/fw_ontology/VagueResourceValue
fw:VagueResourceValue rdf:type owl:Class ;
                           rdfs:subClassOf fw:VagueValue .


###  http://w3id.org/fw_ontology/VagueValue
fw:VagueValue rdf:type owl:Class ;
                   rdfs:comment "Valuable object with unclear but limited references or ranges."@en .


###  Generated by the OWL API (version 4.5.25.2023-02-15T19:15:49Z) https://github.com/owlcs/owlapi

#################################################################
#    Degree, type, method and evidence (for statements such as AMT edges)
#################################################################

# ---- properties -------------------------------------------------------------

fw:hasDegreeOfConnection a owl:DatatypeProperty ;
    rdfs:label "has degree of connection"@en ;
    rdfs:comment "Degree [0-1] to which a connection (statement, edge) holds. Same meaning as amt:weight. Not the same as fw:hasConfidence, which is an assessment by a contributor or a system."@en ;
    rdfs:range xsd:decimal ;
    owl:equivalentProperty amt:weight ;
    rdfs:seeAlso fw:hasConfidence .

fw:hasMethod a owl:ObjectProperty ;
    rdfs:label "has method"@en ;
    rdfs:comment "The method by which a degree (or another fuzziness or uncertainty value) was obtained."@en ;
    rdfs:range fw:Method .

fw:hasType a owl:ObjectProperty ;
    rdfs:label "has type"@en ;
    rdfs:comment "The kind of fuzziness/wobbliness a statement or value is affected by: vagueness, uncertainty, or the two together."@en ;
    rdfs:range fw:FW_Type .

fw:formula a owl:DatatypeProperty ;
    rdfs:label "formula"@en ;
    rdfs:comment "The calculation rule of a method as plain text, e.g. 1 / (n_question + n_possibilities)."@en ;
    rdfs:domain fw:Method ;
    rdfs:range xsd:string .

fw:implementedBy a owl:ObjectProperty ;
    rdfs:label "implemented by"@en ;
    rdfs:comment "Resolvable IRI of the code that implements the method (repository file, release or software DOI)."@en ;
    rdfs:domain fw:Method .

# ---- evidence (optional link from a statement to what its degree is based on) -

fw:derivedFrom a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:label "derived from"@en ;
    rdfs:comment "Optional. Links a statement to what its degree rests on: the evidence it was derived from (source string, image, embedding) or, for a derived statement, the statements it was derived from. Several statements may share one evidence node, which keeps them together (e.g. the alternatives of an OR)."@en .

fw:Evidence a owl:Class ;
    rdfs:label "Evidence"@en ;
    rdfs:comment "What a degree or another fuzziness value is based on, as found in the source."@en .

fw:TextEvidence a owl:Class ;
    rdfs:subClassOf fw:Evidence ;
    rdfs:label "text evidence"@en ;
    rdfs:comment "A text as given in the source, e.g. the string 'Lezoux or Vichy ?'."@en .

fw:MediaEvidence a owl:Class ;
    rdfs:subClassOf fw:Evidence ;
    rdfs:label "media evidence"@en ;
    rdfs:comment "An image, scan, audio or other media object, given by a link; e.g. the image an AI detection was run on."@en .

fw:EmbeddingEvidence a owl:Class ;
    rdfs:subClassOf fw:Evidence ;
    rdfs:label "embedding evidence"@en ;
    rdfs:comment "A semantic embedding (vector) of a text, image or other object, given by a link to the vector and the model that produced it."@en .

fw:sourceString a owl:DatatypeProperty ;
    rdfs:label "source string"@en ;
    rdfs:comment "The text exactly as given in the source."@en ;
    rdfs:domain fw:TextEvidence ;
    rdfs:range xsd:string .

fw:hasMediaLink a owl:ObjectProperty ;
    rdfs:label "has media link"@en ;
    rdfs:comment "Resolvable IRI of the media object (image, scan, audio)."@en ;
    rdfs:domain fw:MediaEvidence .

fw:hasEmbedding a owl:ObjectProperty ;
    rdfs:label "has embedding"@en ;
    rdfs:comment "Resolvable IRI of the vector (a file or an entry in a vector store). The vector itself is not written into the graph."@en ;
    rdfs:domain fw:EmbeddingEvidence .

fw:embeddingModel a owl:DatatypeProperty ;
    rdfs:label "embedding model"@en ;
    rdfs:comment "Name and version of the model that produced the embedding."@en ;
    rdfs:domain fw:EmbeddingEvidence ;
    rdfs:range xsd:string .

# ---- type -------------------------------------------------------------------

fw:FW_Type a owl:Class ;
    rdfs:label "FW type"@en ;
    rdfs:comment "Kind of fuzziness/wobbliness. The terms are individuals, so that fw:hasType points to a term, not to a class."@en .

fw:FuzzinessWobbliness a fw:FW_Type ;
    rdfs:label "fuzziness/wobbliness"@en ;
    rdfs:comment "Umbrella term; used when vagueness and uncertainty cannot be told apart."@en .

fw:Vagueness a fw:FW_Type ;
    rdfs:label "vagueness"@en ;
    skos:broader fw:FuzzinessWobbliness .

fw:Uncertainty a fw:FW_Type ;
    rdfs:label "uncertainty"@en ;
    skos:broader fw:FuzzinessWobbliness .

# ---- value classes: umbrella relation ------------------------------------------

fw:UncertainValue rdfs:subClassOf fw:FuzzinessWobblinessValue .
fw:VagueValue     rdfs:subClassOf fw:FuzzinessWobblinessValue .

# ---- method -----------------------------------------------------------------

fw:Method a owl:Class ;
    rdfs:label "Method"@en ;
    rdfs:comment "A procedure that produces or combines degrees of connection, confidences or other fuzziness values. Concrete methods are individuals and are resolvable by their IRI."@en .

fw:AssignmentMethod a owl:Class ;
    rdfs:subClassOf fw:Method ;
    rdfs:label "assignment method"@en ;
    rdfs:comment "Obtains a degree for a single statement from its source."@en .

fw:PropagationMethod a owl:Class ;
    rdfs:subClassOf fw:Method ;
    rdfs:label "propagation method"@en ;
    rdfs:comment "Combines the degrees along a chain of statements into the degree of a derived statement."@en .

fw:RuleBasedMethod a owl:Class ;
    rdfs:subClassOf fw:AssignmentMethod ;
    rdfs:label "rule-based method"@en ;
    rdfs:comment "A fixed rule applied to the form of the source statement."@en .

fw:StatisticalMethod a owl:Class ;
    rdfs:subClassOf fw:AssignmentMethod ;
    rdfs:label "statistical method"@en ;
    rdfs:comment "A degree computed from observed data by a statistical procedure."@en .

fw:CorrelationMethod a owl:Class ;
    rdfs:subClassOf fw:StatisticalMethod ;
    rdfs:label "correlation method"@en ;
    rdfs:comment "A degree taken from the strength of a correlation between two series, e.g. Pearson."@en .

fw:ProbabilityMethod a owl:Class ;
    rdfs:subClassOf fw:StatisticalMethod ;
    rdfs:label "probability method"@en ;
    rdfs:comment "A degree taken from a probability, classical or estimated."@en .

fw:MachineLearningMethod a owl:Class ;
    rdfs:subClassOf fw:AssignmentMethod ;
    rdfs:label "machine learning method"@en ;
    rdfs:comment "A degree reported by a trained model, e.g. a classifier confidence."@en .

fw:ExpertAssessment a owl:Class ;
    rdfs:subClassOf fw:AssignmentMethod ;
    rdfs:label "expert assessment"@en ;
    rdfs:comment "A degree set by a person from judgement."@en .

# ---- method individuals (examples; the list is open) ------------------------

fw:EqualShareRule a fw:RuleBasedMethod ;
    rdfs:label "equal share rule"@en ;
    rdfs:comment "Reads the AND / OR / '?' form of a source string. The alternatives of an OR share the weight equally, AND keeps the full weight for every entity, and a question mark counts as one more share. Rounded to two decimals. A string that mixes AND and OR is not covered."@en ;
    fw:formula "1 / (n_question + n_possibilities)" .
    # fw:implementedBy <...> follows once the code is published

fw:PearsonCorrelation a fw:CorrelationMethod ;
    rdfs:label "Pearson correlation"@en ;
    fw:formula "r = cov(X, Y) / (sd(X) * sd(Y))" .

fw:ClassicalProbability a fw:ProbabilityMethod ;
    rdfs:label "classical probability"@en ;
    fw:formula "P(A) = favourable cases / possible cases" .

fw:ModelConfidenceScore a fw:MachineLearningMethod ;
    rdfs:label "model confidence score"@en ;
    rdfs:comment "The score a model reports for its own prediction. It is not a calibrated probability unless the model is calibrated."@en .
